---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const LINKEDIN_URL = 'https://www.linkedin.com/in/rushikesh-kotwal-92aab44/';
const EMAIL = 'rushikesh.kotwal80@gmail.com';

const experience = [
	{
		company: 'TechTorch',
		role: 'Assistant Vice President, Commercial Excellence',
		period: 'May 2026 – Present',
		summary:
			'Lead end-to-end commerce strategy, connecting quoting controls with billing and provisioning. Partner with Sales, Deal Desk, Finance, Legal, Product, and Technology leaders to turn business priorities into roadmaps, governance standards, and sequenced investments. Guide CPQ and commercial-platform design across catalog, bundles, pricing, discounting, approvals, amendments, renewals, and asset-based ordering, including AI-driven configuration assistants for sellers.',
	},
	{
		company: 'Pure Storage',
		role: 'Principal Enterprise Architect',
		period: 'May 2024 – May 2026',
		summary:
			'Owned the architecture and operating model for Quote-to-Cash systems. Streamlined the link between quoting rules and billing logic, cutting errors and rework by 30%. Led the integration of Salesforce CPQ with ERP, ran PI planning and UAT, and shaped AI-assisted experiences over Zuora subscription and billing data through an MCP server.',
	},
	{
		company: 'Accenture',
		role: 'Sr. Solution Architect',
		period: 'Dec 2021 – Apr 2024',
		summary:
			'Drove product roadmaps for CPQ transformation programs, architecting pricing structures, product configuration, and SAP and e-commerce integrations for global deployments. Led discovery of AI opportunities across renewals, amendments, and non-standard deals, including an Agentforce use case to find quote bottlenecks and reduce cycle time.',
	},
	{
		company: 'Cognizant / Advanced Technology Group (ATG)',
		role: 'Sr. Manager / Principal Solution Architect',
		period: 'May 2019 – Nov 2021',
		summary:
			'Led the full lifecycle of multiple Salesforce CPQ and Billing programs for Fortune 500 clients, from requirements through design, build, and support. Defined integration strategies across Salesforce CPQ, SAP, and e-commerce platforms, and standardized discounting and advanced pricing models.',
	},
	{
		company: 'Apttus',
		role: 'Sr. Solution Architect',
		period: 'Apr 2016 – Apr 2019',
		summary:
			'Product expert for Apttus CPQ and Quote-to-Cash. Led complex integrations between Apttus and SAP Variant Configuration for BOM-heavy products, ran architecture reviews, built prototypes with product engineering, and delivered demos and proofs of concept to executive stakeholders.',
	},
	{
		company: 'Autodesk (via Cognizant)',
		role: 'Functional Architect',
		period: 'Apr 2012 – Mar 2016',
		summary:
			'Liaison between business leaders and technology teams across Siebel and Salesforce CRM. Defined integration approaches across SAP ECC, Salesforce, and CPQ, automated SKU and BOM setup, and designed end-to-end asset renewal and asset-based ordering solutions.',
	},
	{
		company: 'SAP & Business Applications Consulting',
		role: 'SAP Developer to Techno-Functional Lead',
		period: 'Oct 2005 – Apr 2012',
		summary:
			'Seven years across SAP ERP, SAP CRM, Veeva, and EDI, with a focus on CRM integration, workflow optimization, data migration, and system integration across industries.',
	},
];

const certifications = [
	'Salesforce CPQ Specialist',
	'Salesforce Administrator',
	'Advanced Apttus Quote-to-Cash',
	'TOGAF® Enterprise Architecture Foundation',
	'Certified SAP CRM Consultant',
];

const education = [
	{
		school: 'Berkeley Technology',
		degree: 'Leadership Program in Transforming Business with AI',
		year: '2025',
	},
	{
		school: 'V.J.T.I., Mumbai University',
		degree: 'Bachelor of Electrical Engineering (B.E.)',
		year: '2001',
	},
];

const focusAreas = [
	{
		title: 'CPQ & Quote-to-Cash',
		items: 'Salesforce Revenue Cloud, Agentforce Revenue Cloud (ARM), Conga CPQ, Apttus. Product catalog, bundles, pricing, discounting, approvals, amendments, renewals, billing, and asset-based ordering.',
	},
	{
		title: 'Enterprise Architecture',
		items: 'Reference architectures, target-state roadmaps, architecture governance, business capability mapping, and commercial-systems strategy.',
	},
	{
		title: 'Integration',
		items: 'APIs and data and process integration across SAP, NetSuite, Zuora, and e-commerce platforms.',
	},
	{
		title: 'AI in Revenue Systems',
		items: 'AI-first commerce experiences, intelligent configuration assistants, Agentforce use cases, and MCP-based access to trusted subscription and billing data.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<div class="hero-row">
				<img src="/images/profile.png" alt="Rushikesh Kotwal" class="avatar-lg" />
				<div>
					<h1>Rushikesh Kotwal</h1>
					<p class="role">
						Enterprise Architecture · CPQ &amp; Quote-to-Cash · San Ramon, CA
					</p>
					<p class="lede">
						I'm an enterprise architecture and business systems leader with 20+ years of experience
						across commercial platforms, CPQ, and end-to-end Quote-to-Cash. Today I'm Assistant Vice
						President of Commercial Excellence at TechTorch, where I lead commerce strategy and
						help companies connect quoting, billing, and provisioning into one governed, scalable
						system.
					</p>
				</div>
			</div>

			<section>
				<p>
					Over my career I've shaped enterprise roadmaps, reference architectures, and product
					lifecycles for Salesforce Revenue Cloud and CPQ, Conga, Apttus, and ERP integrations with
					SAP, NetSuite, and Zuora. I've done this inside product companies like Pure Storage and
					Apttus, and as a consultant at Accenture and Cognizant for Fortune 500 clients. The common
					thread is partnering with Sales, Finance, Legal, Product, and Technology leaders to simplify
					complex commercial processes and deliver solutions that hold up at scale.
				</p>
				<p>
					More recently my work has centered on where AI fits into revenue systems: configuration
					assistants that guide sellers to better quotes, Agentforce use cases that surface quote
					bottlenecks, and MCP servers that give teams trusted access to subscription and billing
					data.
				</p>
			</section>

			<section>
				<h2>What I focus on</h2>
				<div class="focus-grid">
					{
						focusAreas.map((f) => (
							<div class="focus-card">
								<h3>{f.title}</h3>
								<p>{f.items}</p>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<h2>Experience</h2>
				<ol class="timeline">
					{
						experience.map((job) => (
							<li>
								<div class="timeline-head">
									<div>
										<strong>{job.role}</strong>
										<span class="company">{job.company}</span>
									</div>
									<span class="period">{job.period}</span>
								</div>
								<p>{job.summary}</p>
							</li>
						))
					}
				</ol>
			</section>

			<div class="two-col">
				<section>
					<h2>Certifications</h2>
					<ul class="plain-list">
						{certifications.map((c) => <li>{c}</li>)}
					</ul>
				</section>
				<section>
					<h2>Education</h2>
					<ul class="plain-list">
						{
							education.map((e) => (
								<li>
									<strong>{e.degree}</strong>
									<br />
									<span class="muted">
										{e.school}, {e.year}
									</span>
								</li>
							))
						}
					</ul>
				</section>
			</div>

			<section>
				<h2>What I write about</h2>
				<p>
					This blog is where I share practical, real-world lessons on GTM systems, CPQ and
					Quote-to-Cash, AI in revenue operations, and enterprise architecture. Expect frameworks,
					design patterns, and honest takes drawn from building and running these systems, written
					for architects, RevOps and Deal Desk leaders, and anyone trying to make revenue systems
					simpler.
				</p>

				<h2>Get in touch</h2>
				<p>
					The best way to reach me is on
					<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>, or by email at
					<a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
				</p>
			</section>
		</main>
		<Footer />
		<style>
			.about-page {
				max-width: 820px;
				margin: 0 auto;
				padding: 3em 1.5em 4em;
			}
			.hero-row {
				display: grid;
				grid-template-columns: 120px 1fr;
				gap: 2em;
				align-items: center;
				margin-bottom: 1.5em;
			}
			.avatar-lg {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				object-fit: cover;
			}
			.about-page h1 {
				margin: 0 0 0.2em;
				font-size: 2.25rem;
			}
			.about-page .role {
				margin: 0 0 0.75em;
				font-size: 0.9rem;
				font-weight: 600;
				letter-spacing: 0.03em;
				color: var(--accent);
			}
			.about-page .lede {
				margin: 0;
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
			}
			.about-page h2 {
				font-size: 1.4rem;
				margin-top: 2em;
				margin-bottom: 0.6em;
			}
			.about-page h3 {
				font-size: 1.05rem;
				margin: 0 0 0.4em;
			}
			.about-page p {
				color: rgb(var(--gray-dark));
			}
			.about-page a {
				color: var(--accent);
			}
			.muted {
				color: rgb(var(--gray));
			}

			/* Focus areas */
			.focus-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1em;
			}
			.focus-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1.1em 1.25em;
				background: #fff;
			}
			.focus-card p {
				margin: 0;
				font-size: 0.95rem;
			}

			/* Timeline */
			.timeline {
				list-style: none;
				padding: 0;
				margin: 0;
				border-left: 2px solid rgb(var(--gray-light));
			}
			.timeline li {
				position: relative;
				padding: 0 0 1.75em 1.5em;
			}
			.timeline li::before {
				content: '';
				position: absolute;
				left: -7px;
				top: 0.45em;
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: var(--accent);
				border: 2px solid #fff;
			}
			.timeline li:last-child {
				padding-bottom: 0;
			}
			.timeline-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				flex-wrap: wrap;
				margin-bottom: 0.35em;
			}
			.timeline-head strong {
				display: block;
				font-size: 1.05rem;
				color: rgb(var(--black));
			}
			.company {
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			.period {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.timeline p {
				margin: 0;
				font-size: 0.95rem;
			}

			/* Two column lists */
			.two-col {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2em;
			}
			.plain-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.plain-list li {
				padding: 0.45em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}
			.plain-list li:last-child {
				border-bottom: none;
			}

			@media (max-width: 720px) {
				.hero-row {
					grid-template-columns: 1fr;
					justify-items: center;
					text-align: center;
				}
				.focus-grid,
				.two-col {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
