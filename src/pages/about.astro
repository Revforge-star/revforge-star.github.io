---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<div class="hero-row">
				<img
					src="/images/profile-placeholder.svg"
					alt="Profile placeholder"
					class="avatar-lg"
				/>
				<div>
					<h1>About</h1>
					<p class="lede">
						Replace this with a short, human introduction. One or two paragraphs is plenty.
					</p>
				</div>
			</div>

			<section>
				<h2>What I write about</h2>
				<p>
					Add a short paragraph here describing the topics you cover on the blog and what readers
					can expect.
				</p>

				<h2>Get in touch</h2>
				<p>
					Add your contact info here — email, LinkedIn, or any other channel where readers can
					reach you.
				</p>
			</section>
		</main>
		<Footer />
		<style>
			.about-page {
				max-width: 760px;
				margin: 0 auto;
				padding: 3em 1.5em 4em;
			}
			.hero-row {
				display: grid;
				grid-template-columns: 120px 1fr;
				gap: 2em;
				align-items: center;
				margin-bottom: 2em;
			}
			.avatar-lg {
				width: 120px;
				height: 120px;
				border-radius: 50%;
			}
			.about-page h1 {
				margin: 0 0 0.25em;
				font-size: 2.25rem;
			}
			.about-page .lede {
				margin: 0;
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
			}
			.about-page h2 {
				font-size: 1.4rem;
				margin-top: 2em;
				margin-bottom: 0.4em;
			}
			.about-page p {
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 720px) {
				.hero-row {
					grid-template-columns: 1fr;
					justify-items: center;
					text-align: center;
				}
			}
		</style>
	</body>
</html>
