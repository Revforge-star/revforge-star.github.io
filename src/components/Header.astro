---
import { SITE_TAGLINE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="brand">
			<a href="/" class="brand-link">{SITE_TITLE}</a>
			<span class="brand-tagline">{SITE_TAGLINE}</span>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0.75em 2em;
		background: white;
		box-shadow: 0 1px 0 rgba(var(--black), 6%);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		gap: 2rem;
	}
	.brand {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}
	.brand-link {
		font-size: 1.25rem;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand-tagline {
		font-size: 0.75rem;
		color: rgb(var(--gray));
		letter-spacing: 0.02em;
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	nav a {
		padding: 0.5em 0.9em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
	}
	nav a.active {
		text-decoration: none;
		color: rgb(var(--black));
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		header {
			padding: 0.75em 1em;
		}
		nav {
			gap: 1rem;
			flex-wrap: wrap;
		}
		.brand-tagline {
			display: none;
		}
	}
</style>
