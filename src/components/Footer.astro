---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<small>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</small>
		<nav>
			<a href="/">Home</a>
			<a href="/blog">Blog</a>
			<a href="/videos">Videos</a>
			<a href="/about">About</a>
		</nav>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em;
		background: white;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
	}
	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
		align-items: center;
		justify-content: space-between;
		font-size: 0.9rem;
	}
	nav {
		display: flex;
		gap: 1.5em;
	}
	nav a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
